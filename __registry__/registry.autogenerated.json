{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "starter-kit",
  "homepage": "https://starter-kit-nu-two.vercel.app",
  "items": [
    {
      "name": "image-upload",
      "type": "registry:component",
      "title": "Image Upload",
      "description": "Unified image upload component supporting single-file (with preview) and multi-file (with drag-drop queue) modes.",
      "dependencies": [
        "sonner",
        "react",
        "lucide-react",
        "cloudinary"
      ],
      "registryDependencies": [
        "input",
        "button"
      ],
      "files": [
        {
          "path": "registry//default/starter-kit-ui/image-upload.tsx",
          "type": "registry:component"
        },
        {
          "path": "registry/.././app/api/upload/route.ts",
          "type": "registry:component"
        },
        {
          "path": "registry/.././app/api/images/route.ts",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "maps-embedder",
      "type": "registry:component",
